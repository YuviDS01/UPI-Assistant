# ── App ────────────────────────────────────────────────
APP_ENV=development
APP_NAME=upi-payment-assistant
LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────
# Matches the postgres service in docker-compose.yml
DATABASE_URL=postgresql+psycopg://upi_user:upi_pass@db:5432/upi_assistant

# ── Redis (session state / LangGraph checkpoints) ───────
REDIS_URL=redis://redis:6379/0

# ── AI ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
CLAUDE_MODEL=claude-sonnet-4-5

# ── Payment provider ─────────────────────────────────────
# mock = MockUPIProvider (default, no real money, no network)
# paytm = PaytmSandboxProvider (Phase 13+)
PAYMENT_PROVIDER=mock

PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_ENV=staging

# ── Dev-mode auth ─────────────────────────────────────────
# Prototype only: every request carries this header instead of real auth.
DEV_USER_HEADER=X-User-ID
